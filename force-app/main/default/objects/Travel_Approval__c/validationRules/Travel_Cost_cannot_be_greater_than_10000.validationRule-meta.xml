<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Travel_Cost_cannot_be_greater_than_10000</fullName>
    <active>true</active>
    <errorConditionFormula>(ISNEW() || ISCHANGED(Travel_Cost__c)) 
&amp;&amp; Travel_Cost__c &gt; 6000
&amp;&amp; $Permission.Bypass_Validation_Rules = FALSE</errorConditionFormula>
    <errorDisplayField>Travel_Cost__c</errorDisplayField>
    <errorMessage>Travel Cost cannot be greater than 10.000</errorMessage>
</ValidationRule>
